 441   4                  // Логируем таймаут (опционально)
 442   4                  sys_write_vp(0x2042, "Timeout         \n", 9);
 443   4           
 444   4                  for(i=0;i<48;i++)
 445   4                  {
 446   5                    buff[i]=0;
 447   5                  }
 448   4                          
 449   4                  // Переход к следующему устройству
 450   4                  current_device=current_device+1;
 451   4                  polling_state = 0;  // Возврат в состояние отправки
 452   4                  rcv_complete=0;
 453   4                  sys_tick=IDLE_TIME;
 454   4              }     
 455   3          } 
 456   2        }
