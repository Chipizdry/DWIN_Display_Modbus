 156   1      
 157   1          for (i = 0; i < length; i++) {
 158   2              temp = temp ^ buffer[i];
 159   2              for (j = 0; j < 8; j++) {
 160   3                  flag = temp & 0x0001;
 161   3                  temp >>= 1;
 162   3                  if (flag)
 163   3                      temp ^= 0xA001;
 164   3              }
 165   2          }
 166   1      
 167   1          // Reverse byte order.
 168   1          temp2 = temp >> 8;
 169   1          temp = (temp << 8) | temp2;
 170   1          temp &= 0xFFFF;
 171   1      
 172   1          return temp;
 173   1      }
